#!/bin/sh
set -eu
case "${SSH_ORIGINAL_COMMAND:-}" in
    "deploy-react "*) release="${SSH_ORIGINAL_COMMAND#deploy-react }" ;;
    *) printf '%s\n' 'Only deploy-react <commit SHA> is allowed.' >&2; exit 1 ;;
esac
case "$release" in
    *[!0-9a-f]*|"") exit 1 ;;
esac
[ "${#release}" -eq 40 ] || exit 1
exec sudo -n /usr/local/sbin/deploy-homestead-react "$release"
